# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# uploads
/public/uploads
/uploads

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Documentation and summary files (exclude from repo)
*.md
!README.md
!SECURITY.md
!SECURITY_QUICKSTART.md
SUMMARY.md
summary.md
docs/

# Log files
*.log
*.txt
!.vercel/README.txt

# Temporary files
temp.*
*.tmp
*.bak

# Build cache
.turbopack/
.cache/

# Scripts (one-time use)
*.ps1
*.cjs
*.js
!next.config.js
!next.config.ts
!postcss.config.mjs
!eslint.config.mjs

# Backup and test files
*.old
*.backup
*_backup.*
test-*.js
verify-*.js
verify-*.ts
check-*.js
check-*.ts
assign-*.js
fix-*.js
list-*.js
find-*.js
set-*.js
update-*.js
cleanup-*.js
quick-*.js

# SQL files (one-time migrations)
*.sql

# Server files (not needed for Vercel)
server.ts
tunnel.js

# Legacy folders
prisma/migrations_legacy/
api/

# Build outputs
build_*.log
build_*.txt
